# Cloudflare Pages honors this file for static assets; the headers() block in
# next.config.ts does not apply on Pages. Hashed build output is immutable.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/flowers/*
